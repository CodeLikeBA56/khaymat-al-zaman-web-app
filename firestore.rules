rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isValidPurchaseInvoiceStatus(status) {
      return status == "DRAFT"
        || status == "POSTED"
        || status == "PARTIALLY_PAID"
        || status == "PAID"
        || status == "VOID";
    }

    function isValidSupplierPaymentStatus(status) {
      return status == "RECORDED" || status == "VOID";
    }

    function isValidSupplierPaymentMethod(method) {
      return method == "CASH"
        || method == "BANK_TRANSFER"
        || method == "CARD"
        || method == "CHEQUE"
        || method == "OTHER";
    }

    function hasValidPurchaseInvoiceShape() {
      return request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumberSearch is string
        && request.resource.data.supplierId is string
        && request.resource.data.invoiceDate is timestamp
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.subTotalMinor is int
        && request.resource.data.subTotalMinor >= 0
        && request.resource.data.taxAmountMinor is int
        && request.resource.data.taxAmountMinor >= 0
        && request.resource.data.discountAmountMinor is int
        && request.resource.data.discountAmountMinor >= 0
        && request.resource.data.grandTotalMinor is int
        && request.resource.data.grandTotalMinor >= 0
        && request.resource.data.paidAmountMinor is int
        && request.resource.data.paidAmountMinor >= 0
        && request.resource.data.remainingPayableMinor is int
        && request.resource.data.remainingPayableMinor >= 0
        && request.resource.data.grandTotalMinor ==
          request.resource.data.subTotalMinor
            + request.resource.data.taxAmountMinor
            - request.resource.data.discountAmountMinor
        && request.resource.data.grandTotalMinor ==
          request.resource.data.paidAmountMinor
            + request.resource.data.remainingPayableMinor
        && request.resource.data.currency is string
        && request.resource.data.currencyMinorUnit is int
        && request.resource.data.currencyMinorUnit >= 0
        && request.resource.data.currencyMinorUnit <= 6
        && isValidPurchaseInvoiceStatus(request.resource.data.status)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedInvoiceIdentityFields() {
      return request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.invoiceNumberSearch == resource.data.invoiceNumberSearch
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasImmutablePostedFinancialFields() {
      return request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.invoiceDate == resource.data.invoiceDate
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.subTotalMinor == resource.data.subTotalMinor
        && request.resource.data.taxAmountMinor == resource.data.taxAmountMinor
        && request.resource.data.discountAmountMinor == resource.data.discountAmountMinor
        && request.resource.data.grandTotalMinor == resource.data.grandTotalMinor
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.currencyMinorUnit == resource.data.currencyMinorUnit;
    }

    function hasPaymentManagedInvoiceStateOnly() {
      return hasImmutablePostedFinancialFields()
        && request.resource.data.status != "DRAFT"
        && request.resource.data.status != "VOID"
        && (
          (request.resource.data.remainingPayableMinor == 0
            && request.resource.data.status == "PAID")
          || (request.resource.data.remainingPayableMinor > 0
            && request.resource.data.paidAmountMinor == 0
            && request.resource.data.status == "POSTED")
          || (request.resource.data.remainingPayableMinor > 0
            && request.resource.data.paidAmountMinor > 0
            && request.resource.data.status == "PARTIALLY_PAID")
        );
    }

    function isDraftEditUpdate() {
      return resource.data.status == "DRAFT"
        && request.resource.data.status == "DRAFT";
    }

    function isDraftPostUpdate() {
      return resource.data.status == "DRAFT"
        && request.resource.data.status == "POSTED"
        && hasImmutablePostedFinancialFields()
        && request.resource.data.paidAmountMinor == 0
        && request.resource.data.remainingPayableMinor == request.resource.data.grandTotalMinor;
    }

    function isControlledVoidUpdate() {
      return (
          resource.data.status == "DRAFT"
          || resource.data.status == "POSTED"
          || resource.data.status == "PARTIALLY_PAID"
        )
        && request.resource.data.status == "VOID"
        && hasImmutablePostedFinancialFields()
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0;
    }

    function isPaymentStateUpdate() {
      return (resource.data.status == "POSTED"
          || resource.data.status == "PARTIALLY_PAID"
          || resource.data.status == "PAID")
        && hasPaymentManagedInvoiceStateOnly();
    }

    function hasValidSupplierPaymentShape() {
      return request.resource.data.paymentNumber is string
        && request.resource.data.paymentNumberSearch is string
        && request.resource.data.supplierId is string
        && request.resource.data.paymentDate is timestamp
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currency is string
        && (
          !("currencyMinorUnit" in request.resource.data)
          || (
            request.resource.data.currencyMinorUnit is int
            && request.resource.data.currencyMinorUnit >= 0
            && request.resource.data.currencyMinorUnit <= 6
          )
        )
        && isValidSupplierPaymentMethod(request.resource.data.method)
        && request.resource.data.allocations is list
        && request.resource.data.unallocatedAmountMinor is int
        && request.resource.data.unallocatedAmountMinor >= 0
        && isValidSupplierPaymentStatus(request.resource.data.status)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedSupplierPaymentIdentityFields() {
      return request.resource.data.paymentNumber == resource.data.paymentNumber
        && request.resource.data.paymentNumberSearch == resource.data.paymentNumberSearch
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.paymentDate == resource.data.paymentDate
        && request.resource.data.amountMinor == resource.data.amountMinor
        && request.resource.data.currency == resource.data.currency
        && (
          (
            !("currencyMinorUnit" in request.resource.data)
            && !("currencyMinorUnit" in resource.data)
          )
          || (
            ("currencyMinorUnit" in request.resource.data)
            && ("currencyMinorUnit" in resource.data)
            && request.resource.data.currencyMinorUnit == resource.data.currencyMinorUnit
          )
        )
        && request.resource.data.method == resource.data.method
        && request.resource.data.allocations == resource.data.allocations
        && request.resource.data.unallocatedAmountMinor == resource.data.unallocatedAmountMinor
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isSupplierPaymentVoidUpdate() {
      return resource.data.status == "RECORDED"
        && request.resource.data.status == "VOID"
        && hasProtectedSupplierPaymentIdentityFields()
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0;
    }

    function hasValidVendorDailyPaymentLimitField() {
      return request.resource.data.dailyPaymentLimit is map
        && request.resource.data.dailyPaymentLimit.min is number
        && request.resource.data.dailyPaymentLimit.min >= 0
        && request.resource.data.dailyPaymentLimit.max is number
        && request.resource.data.dailyPaymentLimit.max >= 0
        && request.resource.data.dailyPaymentLimit.max
          >= request.resource.data.dailyPaymentLimit.min;
    }

    function hasValidExpenseCategoryShape() {
      return request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          !("description" in request.resource.data)
          || request.resource.data.description is string
        )
        && (
          !("icon" in request.resource.data)
          || request.resource.data.icon is string
        )
        && (
          !("color" in request.resource.data)
          || request.resource.data.color is string
        )
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedExpenseCategoryIdentityFields() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidSalaryPlanCategoryShape(category) {
      return category.categoryId is string
        && category.categoryId.size() > 0
        && category.categoryName is string
        && category.categoryName.size() > 0
        && category.budgetAmount is number
        && category.budgetAmount >= 0;
    }

    function hasValidSalaryPlanShape() {
      return request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.salaryAmount is number
        && request.resource.data.salaryAmount >= 0
        && request.resource.data.currency is string
        && request.resource.data.currency.size() > 0
        && request.resource.data.status in ["draft", "active", "closed"]
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 20
        && request.resource.data.totalAllocated is number
        && request.resource.data.totalAllocated >= 0
        && request.resource.data.totalAllocated <= request.resource.data.salaryAmount
        && request.resource.data.totalSpent is number
        && request.resource.data.totalSpent >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedSalaryPlanIdentityFields() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isDraftSalaryPlanEdit() {
      return resource.data.status == "draft"
        && (request.resource.data.status == "draft"
          || request.resource.data.status == "active")
        && hasProtectedSalaryPlanIdentityFields();
    }

    function isSalaryPlanCloseUpdate() {
      return (resource.data.status == "draft"
          || resource.data.status == "active")
        && request.resource.data.status == "closed"
        && hasProtectedSalaryPlanIdentityFields();
    }

    function isSalaryPlanTransactionTotalUpdate() {
      return request.resource.data.status == resource.data.status
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.month == resource.data.month
        && request.resource.data.salaryAmount == resource.data.salaryAmount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.categories == resource.data.categories
        && request.resource.data.totalAllocated == resource.data.totalAllocated
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.totalSpent is number
        && request.resource.data.totalSpent >= 0;
    }

    function hasValidExpenseTransactionShape() {
      return request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryName is string
        && request.resource.data.categoryName.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && (
          !("description" in request.resource.data)
          || request.resource.data.description is string
        )
        && request.resource.data.transactionDate is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy == request.auth.uid;
    }

    function hasProtectedExpenseTransactionIdentityFields() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdBy == request.auth.uid;
    }

    function hasOwnedActiveExpenseCategory(categoryId) {
      let category = get(/databases/$(database)/documents/expenseCategories/$(categoryId)).data;
      return exists(/databases/$(database)/documents/expenseCategories/$(categoryId))
        && category.userId == request.auth.uid
        && category.isActive == true;
    }

    function isCategorySelectedInSalaryPlan(planId, categoryId, categoryName) {
      let plan = get(/databases/$(database)/documents/salaryPlans/$(planId)).data;
      let categories = plan.categories;
      return categories is list
        && categories.size() <= 20
        && (
          (categories.size() > 0
            && categories[0].categoryId == categoryId
            && categories[0].categoryName == categoryName)
          || (categories.size() > 1
            && categories[1].categoryId == categoryId
            && categories[1].categoryName == categoryName)
          || (categories.size() > 2
            && categories[2].categoryId == categoryId
            && categories[2].categoryName == categoryName)
          || (categories.size() > 3
            && categories[3].categoryId == categoryId
            && categories[3].categoryName == categoryName)
          || (categories.size() > 4
            && categories[4].categoryId == categoryId
            && categories[4].categoryName == categoryName)
          || (categories.size() > 5
            && categories[5].categoryId == categoryId
            && categories[5].categoryName == categoryName)
          || (categories.size() > 6
            && categories[6].categoryId == categoryId
            && categories[6].categoryName == categoryName)
          || (categories.size() > 7
            && categories[7].categoryId == categoryId
            && categories[7].categoryName == categoryName)
          || (categories.size() > 8
            && categories[8].categoryId == categoryId
            && categories[8].categoryName == categoryName)
          || (categories.size() > 9
            && categories[9].categoryId == categoryId
            && categories[9].categoryName == categoryName)
          || (categories.size() > 10
            && categories[10].categoryId == categoryId
            && categories[10].categoryName == categoryName)
          || (categories.size() > 11
            && categories[11].categoryId == categoryId
            && categories[11].categoryName == categoryName)
          || (categories.size() > 12
            && categories[12].categoryId == categoryId
            && categories[12].categoryName == categoryName)
          || (categories.size() > 13
            && categories[13].categoryId == categoryId
            && categories[13].categoryName == categoryName)
          || (categories.size() > 14
            && categories[14].categoryId == categoryId
            && categories[14].categoryName == categoryName)
          || (categories.size() > 15
            && categories[15].categoryId == categoryId
            && categories[15].categoryName == categoryName)
          || (categories.size() > 16
            && categories[16].categoryId == categoryId
            && categories[16].categoryName == categoryName)
          || (categories.size() > 17
            && categories[17].categoryId == categoryId
            && categories[17].categoryName == categoryName)
          || (categories.size() > 18
            && categories[18].categoryId == categoryId
            && categories[18].categoryName == categoryName)
          || (categories.size() > 19
            && categories[19].categoryId == categoryId
            && categories[19].categoryName == categoryName)
        );
    }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryPeriods/{salaryPeriodId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryPayments/{salaryPaymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryAdvances/{salaryAdvanceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasValidVendorDailyPaymentLimitField();
      allow update: if isAdmin()
        && hasValidVendorDailyPaymentLimitField()
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /purchaseInvoices/{invoiceId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasValidPurchaseInvoiceShape()
        && request.resource.data.status == "DRAFT";
      allow update: if isAdmin()
        && hasValidPurchaseInvoiceShape()
        && hasProtectedInvoiceIdentityFields()
        && (
          isDraftEditUpdate()
          || isDraftPostUpdate()
          || isPaymentStateUpdate()
          || isControlledVoidUpdate()
        );
      allow delete: if false;
    }

    match /purchaseInvoiceNumbers/{invoiceNumber} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.invoiceNumber == invoiceNumber;
      allow update, delete: if false;
    }

    match /supplierPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasValidSupplierPaymentShape()
        && request.resource.data.status == "RECORDED";
      allow update: if isAdmin()
        && hasValidSupplierPaymentShape()
        && isSupplierPaymentVoidUpdate();
      allow delete: if false;
    }

    match /supplierPaymentNumbers/{paymentNumber} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.paymentNumber == paymentNumber;
      allow update, delete: if false;
    }

    match /supplierPaymentRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /meta/{metaId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;

      let latestPeriod =
        userDoc.workHistory is list && userDoc.workHistory.size() > 0
          ? userDoc.workHistory[userDoc.workHistory.size() - 1]
          : null;

      let latestPeriodIsActive =
        latestPeriod != null
          && (
            !("leftAt" in latestPeriod)
            || latestPeriod.leftAt == null
          );

      let hasAdminRoleFromWorkHistory =
        latestPeriod != null
          && latestPeriod.role == "admin"
          && latestPeriodIsActive;

      // Backward compatibility for legacy documents that still rely on top-level role.
      let hasLegacyAdminRole = userDoc.role == "admin";

      return signedIn()
        && userDoc.isActive == true
        && (hasAdminRoleFromWorkHistory || hasLegacyAdminRole);
    }

    match /expenseCategories/{categoryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && hasValidExpenseCategoryShape();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && hasValidExpenseCategoryShape()
        && hasProtectedExpenseCategoryIdentityFields();
      allow delete: if false;
    }

    match /salaryPlans/{planId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && hasValidSalaryPlanShape()
        && (
          request.resource.data.status == "draft"
          || (
            request.resource.data.status == "active"
            && request.resource.data.categories.size() > 0
          )
        );
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && hasValidSalaryPlanShape()
        && (
          isDraftSalaryPlanEdit()
          || isSalaryPlanCloseUpdate()
          || isSalaryPlanTransactionTotalUpdate()
        );
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.userId == request.auth.uid;
        allow create: if signedIn()
          && hasValidExpenseTransactionShape()
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.status != "closed"
          && isSelectedOwnedExpenseCategory(planId, request.resource.data.categoryId, request.resource.data.categoryName);
        allow update: if signedIn()
          && hasValidExpenseTransactionShape()
          && hasProtectedExpenseTransactionIdentityFields()
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.status != "closed"
          && isSelectedOwnedExpenseCategory(planId, request.resource.data.categoryId, request.resource.data.categoryName);
        allow delete: if signedIn()
          && resource.data.createdBy == request.auth.uid
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/salaryPlans/$(planId)).data.status != "closed";
      }
    }

    function isSelectedOwnedExpenseCategory(planId, categoryId, categoryName) {
      let category = get(/databases/$(database)/documents/expenseCategories/$(categoryId)).data;
      return exists(/databases/$(database)/documents/expenseCategories/$(categoryId))
        && category.userId == request.auth.uid
        && isCategorySelectedInSalaryPlan(planId, categoryId, categoryName);
    }
  }
}
