rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isValidPurchaseInvoiceStatus(status) {
      return status == "DRAFT"
        || status == "POSTED"
        || status == "PARTIALLY_PAID"
        || status == "PAID"
        || status == "VOID";
    }

    function isValidSupplierPaymentStatus(status) {
      return status == "RECORDED" || status == "VOID";
    }

    function isValidSupplierPaymentMethod(method) {
      return method == "CASH"
        || method == "BANK_TRANSFER"
        || method == "CARD"
        || method == "CHEQUE"
        || method == "OTHER";
    }

    function hasValidPurchaseInvoiceShape() {
      return request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumberSearch is string
        && request.resource.data.supplierId is string
        && request.resource.data.invoiceDate is timestamp
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.subTotalMinor is int
        && request.resource.data.subTotalMinor >= 0
        && request.resource.data.taxAmountMinor is int
        && request.resource.data.taxAmountMinor >= 0
        && request.resource.data.discountAmountMinor is int
        && request.resource.data.discountAmountMinor >= 0
        && request.resource.data.grandTotalMinor is int
        && request.resource.data.grandTotalMinor >= 0
        && request.resource.data.paidAmountMinor is int
        && request.resource.data.paidAmountMinor >= 0
        && request.resource.data.remainingPayableMinor is int
        && request.resource.data.remainingPayableMinor >= 0
        && request.resource.data.grandTotalMinor ==
          request.resource.data.subTotalMinor
            + request.resource.data.taxAmountMinor
            - request.resource.data.discountAmountMinor
        && request.resource.data.grandTotalMinor ==
          request.resource.data.paidAmountMinor
            + request.resource.data.remainingPayableMinor
        && request.resource.data.currency is string
        && request.resource.data.currencyMinorUnit is int
        && request.resource.data.currencyMinorUnit >= 0
        && request.resource.data.currencyMinorUnit <= 6
        && isValidPurchaseInvoiceStatus(request.resource.data.status)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedInvoiceIdentityFields() {
      return request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.invoiceNumberSearch == resource.data.invoiceNumberSearch
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasImmutablePostedFinancialFields() {
      return request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.invoiceDate == resource.data.invoiceDate
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.subTotalMinor == resource.data.subTotalMinor
        && request.resource.data.taxAmountMinor == resource.data.taxAmountMinor
        && request.resource.data.discountAmountMinor == resource.data.discountAmountMinor
        && request.resource.data.grandTotalMinor == resource.data.grandTotalMinor
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.currencyMinorUnit == resource.data.currencyMinorUnit;
    }

    function hasPaymentManagedInvoiceStateOnly() {
      return hasImmutablePostedFinancialFields()
        && request.resource.data.status != "DRAFT"
        && request.resource.data.status != "VOID"
        && (
          (request.resource.data.remainingPayableMinor == 0
            && request.resource.data.status == "PAID")
          || (request.resource.data.remainingPayableMinor > 0
            && request.resource.data.paidAmountMinor == 0
            && request.resource.data.status == "POSTED")
          || (request.resource.data.remainingPayableMinor > 0
            && request.resource.data.paidAmountMinor > 0
            && request.resource.data.status == "PARTIALLY_PAID")
        );
    }

    function isDraftEditUpdate() {
      return resource.data.status == "DRAFT"
        && request.resource.data.status == "DRAFT";
    }

    function isDraftPostUpdate() {
      return resource.data.status == "DRAFT"
        && request.resource.data.status == "POSTED"
        && hasImmutablePostedFinancialFields()
        && request.resource.data.paidAmountMinor == 0
        && request.resource.data.remainingPayableMinor == request.resource.data.grandTotalMinor;
    }

    function isControlledVoidUpdate() {
      return (
          resource.data.status == "DRAFT"
          || resource.data.status == "POSTED"
          || resource.data.status == "PARTIALLY_PAID"
        )
        && request.resource.data.status == "VOID"
        && hasImmutablePostedFinancialFields()
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0;
    }

    function isPaymentStateUpdate() {
      return (resource.data.status == "POSTED"
          || resource.data.status == "PARTIALLY_PAID"
          || resource.data.status == "PAID")
        && hasPaymentManagedInvoiceStateOnly();
    }

    function hasValidSupplierPaymentShape() {
      return request.resource.data.paymentNumber is string
        && request.resource.data.paymentNumberSearch is string
        && request.resource.data.supplierId is string
        && request.resource.data.paymentDate is timestamp
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currency is string
        && isValidSupplierPaymentMethod(request.resource.data.method)
        && request.resource.data.allocations is list
        && request.resource.data.unallocatedAmountMinor is int
        && request.resource.data.unallocatedAmountMinor >= 0
        && isValidSupplierPaymentStatus(request.resource.data.status)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasProtectedSupplierPaymentIdentityFields() {
      return request.resource.data.paymentNumber == resource.data.paymentNumber
        && request.resource.data.paymentNumberSearch == resource.data.paymentNumberSearch
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.paymentDate == resource.data.paymentDate
        && request.resource.data.amountMinor == resource.data.amountMinor
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.method == resource.data.method
        && request.resource.data.allocations == resource.data.allocations
        && request.resource.data.unallocatedAmountMinor == resource.data.unallocatedAmountMinor
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isSupplierPaymentVoidUpdate() {
      return resource.data.status == "RECORDED"
        && request.resource.data.status == "VOID"
        && hasProtectedSupplierPaymentIdentityFields()
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryPeriods/{salaryPeriodId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryPayments/{salaryPaymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /salaryAdvances/{salaryAdvanceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /purchaseInvoices/{invoiceId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasValidPurchaseInvoiceShape()
        && request.resource.data.status == "DRAFT";
      allow update: if isAdmin()
        && hasValidPurchaseInvoiceShape()
        && hasProtectedInvoiceIdentityFields()
        && (
          isDraftEditUpdate()
          || isDraftPostUpdate()
          || isPaymentStateUpdate()
          || isControlledVoidUpdate()
        );
      allow delete: if false;
    }

    match /purchaseInvoiceNumbers/{invoiceNumber} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.invoiceNumber == invoiceNumber;
      allow update, delete: if false;
    }

    match /supplierPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasValidSupplierPaymentShape()
        && request.resource.data.status == "RECORDED";
      allow update: if isAdmin()
        && hasValidSupplierPaymentShape()
        && isSupplierPaymentVoidUpdate();
      allow delete: if false;
    }

    match /supplierPaymentNumbers/{paymentNumber} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.paymentNumber == paymentNumber;
      allow update, delete: if false;
    }

    match /supplierPaymentRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /meta/{metaId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;

      let latestPeriod =
        userDoc.workHistory is list && userDoc.workHistory.size() > 0
          ? userDoc.workHistory[userDoc.workHistory.size() - 1]
          : null;

      let latestPeriodIsActive =
        latestPeriod != null
          && (
            !("leftAt" in latestPeriod)
            || latestPeriod.leftAt == null
          );

      let hasAdminRoleFromWorkHistory =
        latestPeriod != null
          && latestPeriod.role == "admin"
          && latestPeriodIsActive;

      // Backward compatibility for legacy documents that still rely on top-level role.
      let hasLegacyAdminRole = userDoc.role == "admin";

      return signedIn()
        && userDoc.isActive == true
        && (hasAdminRoleFromWorkHistory || hasLegacyAdminRole);
    }
  }
}
